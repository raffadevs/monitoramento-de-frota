# PostgreSQL (imagem com PostGIS pré-instalado)
POSTGRES_DB=frota
POSTGRES_USER=frota
POSTGRES_PASSWORD=change-me

# Simulador (gera veículos de demonstração que se movem e publicam via MQTT)
SIMULADOR_HABILITADO=true
SIMULADOR_VEICULOS=30

# Portas expostas no host pelo docker-compose (ajuste se já estiverem em uso)
BACKEND_PORT=8077
FRONTEND_PORT=8094
MQTT_PORT=1883
